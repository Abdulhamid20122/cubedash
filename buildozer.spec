[app]
title = Cube Dash
package.name = cubedash
package.domain = org.cubedash
source.dir = .
source.include_exts = py
version = 1.0
requirements = python3,kivy==2.3.1,pyjnius
orientation = all
fullscreen = 1
android.archs = arm64-v8a
android.api = 33
android.minapi = 21
android.ndk = 25b
android.ndk_api = 21
android.accept_sdk_license = True
p4a.branch = develop

[buildozer]
log_level = 2
warn_on_root = 0
